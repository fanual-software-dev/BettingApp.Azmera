# Provider games remain sandbox-only. Manual payment handling is configured separately.
APP_MODE=sandbox
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/azmera.sqlite
PUBLIC_APP_URL=http://localhost:3000
# Set false when exposing the service beyond your own machine.
ALLOW_LOCAL_LOGIN=true
# Obtain from BotFather; never expose either value to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Reference placeholders only: live adapters are NOT implemented.
SPRIBE_API_BASE_URL=
SPRIBE_API_KEY=
# Assigned by your supplier; these are not Telegram credentials.
SPRIBE_OPERATOR_ID=
SPRIBE_GAME_ID=
# Comma-separated exact HTTPS origins supplied for game embedding.
SPRIBE_LAUNCH_ORIGINS=
# The wire adapter and signature algorithm still require supplier documentation.
SPRIBE_SIGNING_SECRET=
SMARTSOFT_API_BASE_URL=
SMARTSOFT_API_KEY=
INOUT_API_BASE_URL=
INOUT_API_KEY=
# Obtain these from INOUT B2B onboarding for the original Chicken Road.
INOUT_OPERATOR_ID=
INOUT_CHICKEN_ROAD_GAME_ID=
INOUT_LAUNCH_ORIGINS=
INOUT_SIGNING_SECRET=
AVIATRIX_API_BASE_URL=
AVIATRIX_BRAND_ID=
AVIATRIX_SIGNING_SECRET=
KENO_PROVIDER=
KENO_GAME_ID=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Manual CBE / Telebirr deposits and withdrawals. Disabled until configured.
MANUAL_PAYMENTS_ENABLED=false
# Comma-separated owner Telegram user IDs (not phone numbers or usernames).
PAYMENT_ADMIN_TELEGRAM_IDS=
CBE_ACCOUNT_NUMBER=
CBE_ACCOUNT_HOLDER=
TELEBIRR_NUMBER=
TELEBIRR_ACCOUNT_HOLDER=
# Initial receiving accounts are seeded once. Use Wallet > Payment review to switch accounts later.
